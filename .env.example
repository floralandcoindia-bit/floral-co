# ---- Browser (safe to expose; these are public by design) -------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---- Server only: add these in Vercel > Settings > Environment Variables. NEVER commit or share them. ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
CRON_SECRET=a-long-random-string-you-invent
